PORT=3000

# Non-standard host ports (27018 / 6380) on purpose: if you already have a
# local MongoDB/Redis install or another container using the default ports
# (27017 / 6379), "localhost" would silently resolve to THAT instance
# instead of this project's containers, and you'd see no data / wrong data.
# Match these to whatever you pass to `docker run -p` in the README.
MONGO_URL=mongodb://localhost:27018
MONGO_DB_NAME=cache_demo

REDIS_URL=redis://localhost:6380

# Artificial delay (ms) added to every MongoDB read/write so the effect of
# caching (or deferring writes) is obvious in the response times and logs.
DB_LATENCY_MS=300

# How often the Write-Back strategy flushes dirty cache entries to MongoDB.
WRITE_BACK_FLUSH_INTERVAL_MS=10000
